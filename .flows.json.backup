    {
        "id": "b66266e4c64bcef9",
        "type": "function",
        "z": "054a40703d786c9d",
        "name": "Upload ST",
        "func": "let upload_bandwidth = msg.payload.upload.bandwidth/125000\n\nupload_bandwidth = Math.round(upload_bandwidth);\nmsg.payload = upload_bandwidth;\n\nreturn msg;",
