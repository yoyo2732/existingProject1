            ]
        ]
    },
    {
        "id": "d50a31ae3c9015ff",
        "type": "function",
        "z": "054a40703d786c9d",
        "name": "Download ST",
        "func": "let download_bandwidth = msg.payload.download.bandwidth/125000\n\ndownload_bandwidth = Math.round(download_bandwidth);\n\nmsg.payload = download_bandwidth;\nmsg.topic = \"\"\n\nreturn msg;",
